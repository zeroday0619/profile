{
  "name": "profile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/opennext.mjs build && node scripts/opennext.mjs preview",
    "deploy": "node scripts/opennext.mjs build && node scripts/opennext.mjs deploy",
    "upload": "node scripts/opennext.mjs build && node scripts/opennext.mjs upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@headlessui/react": "^2.2.10",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.0",
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
